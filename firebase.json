{
  "functions": [
    { "source": "functions", "codebase": "default" },
    { "source": "wallet-proxy", "codebase": "wallet" }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["node scripts/copy-privacy.js", "node scripts/inject-meta.js"],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      { "source": "/api/**", "function": "walletProxy", "region": "us-central1" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
