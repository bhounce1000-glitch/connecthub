rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'bhounce1000@gmail.com';
    }

    function isOwner(email) {
      return isSignedIn() && request.auth.token.email == email;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isNotDisposable() {
      let userEmail = request.auth.token.email;
      return !userEmail.matches('.*@mailinator\\.com')
        && !userEmail.matches('.*@guerrillamail\\.com')
        && !userEmail.matches('.*@tempmail\\.com')
        && !userEmail.matches('.*@yopmail\\.com')
        && !userEmail.matches('.*@trashmail\\.com')
        && !userEmail.matches('.*@example\\.com')
        && !userEmail.matches('.*@test\\.com');
    }

    function isNotBanned() {
      return !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.token.email));
    }

    function validUser() {
      return isSignedIn() && isNotDisposable() && isNotBanned();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isOwner(userId)
        && isNotDisposable()
        && request.resource.data.keys().hasAll(['email', 'role', 'createdAt']);
      allow update: if (isOwner(userId) || isAdmin()) && isNotDisposable();
      allow delete: if isAdmin();
    }

    match /bannedUsers/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if validUser()
        && request.resource.data.keys().hasAll(['title', 'user', 'status', 'createdAt'])
        && (request.resource.data.status == 'OPEN' || request.resource.data.status == 'open')
        && request.resource.data.user == request.auth.token.email
        && (!('paid' in request.resource.data) || request.resource.data.paid == false)
        && (!('payment_received' in request.resource.data) || request.resource.data.payment_received == false)
        && (!('work_started' in request.resource.data) || request.resource.data.work_started == false)
        && (!('work_completed' in request.resource.data) || request.resource.data.work_completed == false)
        && (!('customer_confirmed' in request.resource.data) || request.resource.data.customer_confirmed == false)
        && (!('payment_released' in request.resource.data) || request.resource.data.payment_released == false);
      allow update: if validUser()
        && (
          isAdmin()
          || (
            resource.data.user == request.auth.token.email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'preferredDate', 'image', 'updatedAt', 'location', 'locationText', 'urgency'])
          )
          || (
            resource.data.user == request.auth.token.email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'review', 'ratedAt', 'updatedAt', 'ratingRequiredBy'])
          )
          || (
            resource.data.acceptedBy == request.auth.token.email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerRating', 'customerReview', 'customerRatedAt', 'updatedAt'])
          )
        );
      allow delete: if isAdmin();
    }

    match /transactions/{txId} {
      allow read: if isSignedIn() && (
        resource.data.senderEmail == request.auth.token.email
        || resource.data.receiverEmail == request.auth.token.email
        || isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.token.email
        || isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && (
        resource.data.email == request.auth.token.email
        || isAdmin()
      );
      allow create: if validUser() && request.resource.data.email == request.auth.token.email;
      allow update, delete: if isAdmin();
    }

    match /kyc_submissions/{email} {
      allow read: if isOwner(email) || isAdmin();
      allow create: if isOwner(email) && validUser();
      allow update: if isOwner(email) || isAdmin();
      allow delete: if isAdmin();
    }

    match /chats/{jobId}/messages/{messageId} {
      allow read, write: if isSignedIn();
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if validUser();
      allow update, delete: if isAdmin();
    }

    match /subscriptions/{email} {
      allow read, write: if isOwner(email) || isAdmin();
    }

    match /otp_verifications/{email} {
      allow read: if isOwner(email);
      allow write: if false;
    }

    match /fraudAlerts/{alertId} {
      allow read, write: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /portfolios/{email}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(email);
      allow delete: if isOwner(email) || isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
