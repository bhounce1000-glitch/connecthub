rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // KYC profile photos — user uploads their own selfie
    match /kyc_photos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // KYC identity documents (front and back of ID)
    match /kyc_documents/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024;
    }

    // KYC dispute evidence photos
    match /disputes/{userId}/{requestId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Provider portfolio photos
    match /portfolio/{userEmail}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == userEmail
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Profile avatars
    match /avatars/{userEmail}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == userEmail
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
