rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      // ADMIN LOGIN ACCOUNT — do not change this to support email
      return request.auth != null
        && request.auth.token.email in ['bhounce1000@gmail.com'];
    }

    // Canonical KYC directory path (owner + admin only)
    match /kyc/{userEmail}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.token.email == userEmail || isAdmin());
      allow write: if request.auth != null
        && request.auth.token.email == userEmail
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && isAdmin();
    }

    // KYC profile photos — owner or admin read only (contains sensitive biometrics)
    match /kyc_photos/{userId}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // KYC identity documents — owner or admin read only
    match /kyc_documents/{userId}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // KYC dispute evidence — owner or admin read only
    match /disputes/{userId}/{requestId}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Username change verification ID — owner write, admin read only (sensitive ID doc)
    match /username-change-id/{userId}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Profile pictures — public read, owner write
    match /profile-pictures/{userId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Job request images — uploader write, public read
    match /request-images/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Provider portfolio photos
    match /portfolio/{userEmail}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == userEmail
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && request.auth.token.email == userEmail;
    }

    // Additional profile path support
    match /profiles/{userEmail}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == userEmail
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Profile avatars
    match /avatars/{userEmail}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == userEmail
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
